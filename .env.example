# General
APP_NAME=Vecino Centinela
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_PORT=3000
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Security
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg2://vecino:vecino@postgres:5432/vecinocentinela

# Redis
REDIS_URL=redis://redis:6379/0

# Seed development credentials
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-in-development

# URL pública que usará el navegador para llamar al API.
# En producción debe apuntar al endpoint HTTPS del API, no a localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
